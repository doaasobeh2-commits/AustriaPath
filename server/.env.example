# AustriaPath server-only environment (local dev)
# Copy to server/.env and fill values from your password manager.
# NEVER commit server/.env to git.

# Public learner app URL for password-reset / verification email links
PUBLIC_APP_URL=http://localhost:5173

# Transactional email (required in production)
# RESEND_API_KEY=
# EMAIL_FROM=AustriaPath <noreply@austriapath.at>

# B1 Weekly Training AI (isolated from Placement / generic OPENAI_API_KEY)
B1_WEEKLY_PLAN_AI_ENABLED=true
WEEKLY_TRAINING_B1_OPENAI_API_KEY=
WEEKLY_TRAINING_B1_MODEL=gpt-5.6-sol
